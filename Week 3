score = int(input("Enter your score (0-100): "))

if score >= 90:
    grade = "A"
elif score >= 80:  
    grade = "B"
elif score >= 70:  
    grade = "C"
elif score >= 60:  
    grade = "D"
else:
    grade = "F"

print(f"Your grade is: {grade}") # Added space in string

# Bonus: print encouragement for top band grades
if grade == "A":
